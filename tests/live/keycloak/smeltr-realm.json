{
  "realm": "smeltr",
  "enabled": true,
  "sslRequired": "none",
  "groups": [{ "name": "smeltr-admins" }],
  "users": [
    {
      "username": "ada",
      "enabled": true,
      "email": "ada@example.com",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Lovelace",
      "credentials": [{ "type": "password", "value": "smeltr-live-1", "temporary": false }],
      "groups": ["/smeltr-admins"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Outsider",
      "credentials": [{ "type": "password", "value": "smeltr-live-1", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "smeltr",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "smeltr-live-1",
