# The final image, from a binary already compiled. `Dockerfile`'s export stage writes the folder this belongs to:
# this file, named `Dockerfile`, with `smeltr`, `wolfi-root.sh`, `compose.yaml`, `LICENSE` and
# `THIRD-PARTY-NOTICES.md` beside it.
# Nothing compiles here.
#
# The image is a root of Wolfi's packages (wolfi-root.sh) with the binary added, as `Dockerfile` builds it. Wolfi's
# glibc only moves forward and keeps its old symbol versions, so a root resolved after the binary was compiled
# carries the glibc it was compiled against or a newer one. Building needs packages.wolfi.dev.
FROM alpine:3.23@sha256:469c9ea410b9215eaee7976ba6c0639039b444be8e5d638f7abbada189971eb2 AS wolfi
ADD --checksum=sha256:f0031424cf46f7db780ce63a45f0fd6aa6f85f601e6bb3b7a91fe3d4d5b7d2cc \
    https://packages.wolfi.dev/os/wolfi-signing.rsa.pub /etc/apk/keys/wolfi-signing.rsa.pub
COPY wolfi-root.sh /wolfi-root.sh
RUN sh /wolfi-root.sh image /rootfs

FROM scratch
COPY --from=wolfi /rootfs /
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The mode is set here rather than carried: the binary travels as a loose file, and an archive can drop its
# execute bit. No `# syntax=` directive above, which would send BuildKit to Docker Hub for a frontend image an
# air-gapped site cannot reach.
COPY --chmod=0755 smeltr /usr/local/bin/smeltr
COPY LICENSE THIRD-PARTY-NOTICES.md /usr/share/doc/smeltr/

# The image starts from scratch, so it carries only these labels.
# `just dist` passes the release as VERSION; a build here without `--build-arg VERSION=<release>` leaves it blank.
ARG VERSION=""
LABEL org.opencontainers.image.title="smeltr" \
      org.opencontainers.image.description="Smeltr leader and worker" \
      org.opencontainers.image.vendor="John Pavlik" \
      org.opencontainers.image.licenses="BUSL-1.1" \
      org.opencontainers.image.version="${VERSION}" \
      name="smeltr" \
      summary="Smeltr leader and worker" \
      description="Smeltr leader and worker" \
      io.k8s.display-name="smeltr" \
      io.k8s.description="Smeltr leader and worker" \
      vendor="John Pavlik" \
      maintainer="John Pavlik" \
      version="${VERSION}"

USER 1000
# The state paths are relative, so they land here: the leader's data and its sealing key, and the worker's
# state. Mount this to keep them across a replacement.
WORKDIR /var/lib/smeltr

# No port here. The default is 443, which a non-root process cannot bind, so whoever runs this picks one.
# `docker run` wants `-e SMELTR_GUI_PORT=8443 -p 443:8443`, and a deployment sets
# `leader.http.bind = "0.0.0.0"` besides, since the bind defaults to loopback.
ENTRYPOINT ["/usr/local/bin/smeltr"]
