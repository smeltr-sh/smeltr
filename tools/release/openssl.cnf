# The image's OpenSSL runs FIPS only: OpenSSL's validated FIPS provider does every operation, and the base provider
# only encodes and decodes keys. An algorithm outside it, such as MD5, fails rather than falls back.
config_diagnostics = 1
openssl_conf = openssl_init

.pragma includedir:/etc/ssl
.include fipsmodule.cnf

[openssl_init]
providers = provider_sect
alg_section = algorithm_sect
ssl_conf = ssl_module

[provider_sect]
fips = fips_sect
base = base_sect

[base_sect]
activate = 1

[algorithm_sect]
default_properties = fips=yes

[ssl_module]
system_default = tls_sect

[tls_sect]
MinProtocol = TLSv1.2
Groups = secp256r1:secp384r1:secp521r1
Ciphersuites = TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256
CipherString = ECDHE+AESGCM:@SECLEVEL=2
