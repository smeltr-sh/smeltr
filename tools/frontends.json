{
  "gui": {
    "dir": "gui-frontend",
    "script": "build",
    "output": "dist",
    "sources": [
      "src",
      "public",
      "index.html",
      "package.json",
      "vite.config.ts",
      "svelte.config.js",
      "../website/src/lib/highlight",
      "../website/src/lib/foundry",
      "../website/src/lib/reference.json",
      "../website/src/lib/code-language.json"
    ],
    "embed": {
      "missing": "GUI baked in -- it will serve a page saying so",
      "placeholder": "not-built"
    }
  },
  "docs": {
    "dir": "website",
    "script": "build",
    "output": "leader-docs",
    "sources": ["src", "scripts", "package.json", "vite.config.ts"],
    "embed": {
      "missing": "docs for its AI agent to read"
    }
  },
  "demo": {
    "dir": "gui-frontend",
    "script": "build:demo",
    "output": "dist-demo",
    "sources": [
      "src",
      "public",
      "demo.html",
      "package.json",
      "vite.config.ts",
      "vite.demo.config.ts",
      "svelte.config.js",
      "../website/src/lib/highlight",
      "../website/src/lib/foundry",
      "../website/src/lib/reference.json",
      "../website/src/lib/code-language.json"
    ]
  }
}
