#!/usr/bin/env bash
# Replaces the ECS and OCSF releases smeltr carries (`schema::standard`): ECS's generated/csv/fields.csv at tag
# v<ecs>, and OCSF at tag <ocsf> compiled by ocsf-schema-compiler, which needs Python 3.14 (run here through uv), and
# cut to what `schema::ocsf` reads, so the binary carries a third of it.
set -euo pipefail
ecs=$1
ocsf=$2
out=src/schema/standards
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

curl -fsSL "https://raw.githubusercontent.com/elastic/ecs/v$ecs/generated/csv/fields.csv" -o "$out/ecs-fields.csv"

git -c advice.detachedHead=false clone -q --depth 1 --branch "$ocsf" https://github.com/ocsf/ocsf-schema.git "$work/ocsf"
uvx --python 3.14 ocsf-schema-compiler "$work/ocsf" > "$work/compiled.json"
python3 -I "$(dirname "$0")/cut_ocsf.py" "$work/compiled.json" "$out/ocsf.json"
