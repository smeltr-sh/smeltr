#!/usr/bin/env bash
# Replaces the ECS and OCSF releases smeltr carries (`schema::standard`): ECS's generated/csv/fields.csv at tag
# v<ecs>, and each OCSF release named, at its tag, compiled by ocsf-schema-compiler, which needs Python 3.14 (run here
# through uv), and cut to what `schema::ocsf` reads, so the binary carries a third of it. A release added or dropped
# is also added to or dropped from `schema::standard::OCSF`.
set -euo pipefail
ecs=$1
shift
out=src/schema/standards
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

curl -fsSL "https://raw.githubusercontent.com/elastic/ecs/v$ecs/generated/csv/fields.csv" -o "$out/ecs-fields.csv"

rm -f "$out"/ocsf-*.json
for ocsf in "$@"; do
    git -c advice.detachedHead=false clone -q --depth 1 --branch "$ocsf" https://github.com/ocsf/ocsf-schema.git "$work/$ocsf"
    uvx --python 3.14 ocsf-schema-compiler "$work/$ocsf" > "$work/$ocsf.json"
    python3 -I "$(dirname "$0")/cut_ocsf.py" "$work/$ocsf.json" "$out/ocsf-$ocsf.json"
done
