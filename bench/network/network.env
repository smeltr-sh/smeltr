# The link between this host and every service a live benchmark talks to: a
# cloud region to a service in another, at the round trip, jitter and loss a
# healthy path between regions shows. Each value is one way, so the round trip
# is twice the delay and a packet is lost at about twice the loss.
NETEM_DELAY=20ms
NETEM_JITTER=2ms
NETEM_LOSS=0.05%
NETEM_RATE=1gbit
