            "assignments": [{ "target": "ecs.version", "expr": "\"8.11\"" }]
          }
        ]
      }
    ],
    "input": [
      { "status": 503, "path": "/pay" },
      { "status": 200, "path": "/home" }
    ],
    "output": [
      { "status": 503, "path": "/pay", "ecs": { "version": "8.11" } },
      { "status": 200, "path": "/home", "ecs": { "version": "8.11" } }
    ]
  },
