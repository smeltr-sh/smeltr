{
  "basic": {
    "steps": [
      {
        "id": "parse",
        "type": "parser",
        "input": "_raw",
        "kind": { "type": "json" },
        "declared": [{ "name": "status", "type": "i64" }]
      },
      { "id": "call", "type": "call", "pipeline": "stamp-ecs" }
    ],
    "pipelines": [
      {
        "id": "stamp-ecs",
        "name": "stamp-ecs",
        "steps": [
          {
