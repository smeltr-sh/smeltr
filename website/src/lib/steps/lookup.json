  "regex": {
    "lookupTables": [
      {
        "id": "roles",
        "type": "inline",
        "headers": ["pattern", "role"],
        "rows": [
          ["^web-", "web"],
          ["^db-", "database"],
          ["^db-.*-replica$", "replica"]
        ]
      }
    ],
    "steps": [
      {
        "id": "parse",
        "type": "parser",
        "input": "_raw",
        "kind": {
          "type": "json"
        },
        "declared": [
          {
            "name": "host",
            "type": "str"
          }
        ]
      },
      {
        "id": "lookup",
        "type": "lookup",
        "input": "host",
        "table": "roles",
        "matchKind": "regex",
        "multiplicity": "best",
        "keyColumn": "pattern",
        "outputs": [
          {
            "source": "role",
            "field": "role",
            "default": "other"
          }
        ]
      }
    ],
    "input": [
      {
        "host": "db-03-replica"
      },
      {
        "host": "db-01"
      },
      {
        "host": "web-02"
      },
      {
        "host": "cache-01"
      }
    ],
    "output": [
      {
        "host": "db-03-replica",
        "role": "replica"
      },
      {
        "host": "db-01",
        "role": "database"
      },
      {
        "host": "web-02",
        "role": "web"
      },
      {
        "host": "cache-01",
        "role": "other"
      }
    ]
  }
}
