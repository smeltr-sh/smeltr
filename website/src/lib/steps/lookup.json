{
  "exact": {
    "lookupTables": [
      {
        "id": "users",
        "type": "inline",
        "headers": ["user", "team", "level"],
        "rows": [
          ["alice", "payments", "3"],
          ["bob", "search", "1"]
        ]
      }
    ],
    "steps": [
      {
        "id": "parse",
        "type": "parser",
        "input": "_raw",
        "kind": {
          "type": "json"
        },
        "declared": [
          {
            "name": "user",
            "type": "str"
          }
        ]
      },
      {
        "id": "lookup",
        "type": "lookup",
        "input": "user",
        "table": "users",
        "matchKind": "exact",
        "multiplicity": "best",
        "keyColumn": "user",
        "outputs": [
          {
            "source": "team",
            "field": "team",
            "default": "unknown"
          },
          {
            "source": "level",
            "field": "user_level",
            "default": "",
            "type": "i64"
          }
        ]
      }
    ],
    "input": [
      {
        "user": "alice"
      },
      {
        "user": "carol"
      }
    ],
    "output": [
      {
        "user": "alice",
        "team": "payments",
        "user_level": 3
      },
      {
        "user": "carol",
        "team": "unknown"
      }
    ]
  },
  "cidr": {
    "lookupTables": [
      {
        "id": "networks",
        "type": "inline",
        "headers": ["network", "zone"],
        "rows": [
          ["10.0.0.0/8", "internal"],
          ["10.1.0.0/16", "office"]
        ]
      }
    ],
    "steps": [
      {
        "id": "parse",
        "type": "parser",
        "input": "_raw",
