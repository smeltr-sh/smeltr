      },
      {
        "id": "lookup",
        "type": "lookup",
        "input": "client_ip",
        "table": "networks",
        "matchKind": "cidr",
        "multiplicity": "best",
        "keyColumn": "network",
        "outputs": [
          {
            "source": "zone",
            "field": "zone",
            "default": "external"
          }
        ]
      }
    ],
    "input": [
      {
        "client_ip": "10.1.2.3"
      },
      {
        "client_ip": "10.9.0.1"
      },
      {
        "client_ip": "8.8.8.8"
      }
    ],
    "output": [
      {
        "client_ip": "10.1.2.3",
        "zone": "office"
      },
      {
        "client_ip": "10.9.0.1",
        "zone": "internal"
      },
      {
        "client_ip": "8.8.8.8",
        "zone": "external"
      }
    ]
  },
  "cidrAll": {
    "lookupTables": [
      {
        "id": "networks",
        "type": "inline",
        "headers": ["network", "zone"],
        "rows": [
          ["10.0.0.0/8", "internal"],
          ["10.1.0.0/16", "office"]
        ]
      }
    ],
    "steps": [
      {
        "id": "parse",
        "type": "parser",
        "input": "_raw",
        "kind": {
          "type": "json"
        },
        "declared": [
          {
            "name": "client_ip",
            "type": "str"
          }
        ]
      },
      {
        "id": "lookup",
        "type": "lookup",
        "input": "client_ip",
        "table": "networks",
        "matchKind": "cidr",
