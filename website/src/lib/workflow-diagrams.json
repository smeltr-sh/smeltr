            "detail": ["Use the action you selected"]
          },
          {
            "x": 20,
            "y": 390,
            "w": 260,
            "title": "Hold and retry (default)",
            "detail": ["Keep the record; pause input"]
          },
          {
            "x": 320,
            "y": 390,
            "w": 260,
            "title": "Send elsewhere",
            "detail": ["Wait for each chosen", "destination to accept"]
          },
          {
            "x": 620,
