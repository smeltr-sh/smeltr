  "remote": {
    "title": "Follow a Git host",
    "description": "A save in the Smeltr UI is a branch on the leader, which the leader pushes to the Git host. The host reviews and merges it to main. The leader fetches main, loads every worker group at it and deploys it only if all of them load. Workers fetch the deployed commit from the leader.",
    "caption": "Branches go out to the host and main comes back. Workers only ever talk to the leader.",
    "layouts": [
      {
        "width": 900,
        "height": 290,
        "nodes": [
          {
            "x": 300,
            "y": 10,
            "w": 200,
            "title": "Git host",
            "detail": ["Review, merge to main"]
          },
